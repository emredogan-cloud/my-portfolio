{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/auto-tweet",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/auto-tweet?mode=weekly_architecture",
      "schedule": "0 5 * * 2"
    },
    {
      "path": "/api/notes/regenerate-audio",
      "schedule": "0 4 * * 1"
    }
  ]
}
